{
  "name": "tumbo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --configuration local",
    "build": "ng build",
    "icons": "node tools/generar-iconos.mjs",
    "icons:android": "npx @capacitor/assets generate --android",
    "prebuild": "node tools/generar-entorno.mjs",
    "build:local": "ng build --configuration local",
    "build:apk": "ng build --configuration apk",
    "apk": "npm run build:apk && npx cap sync android",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "cap:sync": "npm run build && npx cap sync",
    "supabase:tipos": "npx supabase gen types typescript --linked > src/app/core/models/base-de-datos.ts",
    "supabase:usuarios": "node supabase/crear-usuarios.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@ionic/angular": "^9.0.1",
    "@supabase/supabase-js": "^2.112.4",
    "node": "^26.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@capacitor/assets": "^3.0.5",
    "jsdom": "^28.0.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.8.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
